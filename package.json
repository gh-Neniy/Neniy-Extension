{
  "name": "neniy",
  "displayName": "Neniy",
  "description": "Neniy Programming Language",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "neniy",
        "aliases": [
          "neniy",
          "neniy"
        ],
        "extensions": [
          ".neniy"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "configuration": {
      "title": "Settings for neniy",
      "properties": {
        "neniy.minecraftVersion": {
          "type": "string",
          "description": "Minecraft version"
        },
        "neniy.outputDirectory": {
          "type": "string",
          "description": "Output directory"
        }
      }
    },
    "grammars": [
      {
        "language": "neniy",
        "scopeName": "source.neniy",
        "path": "./syntaxes/neniy.tmLanguage.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gh-Neniy/Neniy-Extension.git"
  },
  "keywords": [],
  "author": "Neniy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gh-Neniy/Neniy-Extension/issues"
  },
  "homepage": "https://github.com/gh-Neniy/Neniy-Extension#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.110.0",
    "typescript": "^7.0.2"
  }
}
