{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "neniy",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "match": "(^|\\brun\\s+)(data|clear|clone|ex|fill|fn|gm|give|kill|let|pls|ptc|say|scb|setblock|sm|tellraw|time|tp|use)\\b",
          "captures": {
            "1": {
              "name": "keyword"
            },
            "2": {
              "name": "keyword.control"
            }
          }
        },
        {
          "match": "(^|\\brun\\s+)(gamerule|native|tag|team|spectate|damage|effect|stopsound|spawnpoint|title|bossbar|advancement)\\b",
          "captures": {
            "1": {
              "name": "keyword"
            },
            "2": {
              "name": "keyword.control"
            }
          }
        },
        {
          "match": "(^|\\brun\\s+)(attribute|random|loot)\\b",
          "captures": {
            "1": {
              "name": "keyword"
            },
            "2": {
              "name": "keyword.control"
            }
          }
        },
        {
          "match": "(\\b(if|unless|items)\\s+)(block)\\b",
          "captures": {
            "2": {
              "name": "keyword"
            },
            "3": {
              "name": "keyword"
            }
          }
        },
        {
          "match": "(\\b(store)\\s+)(storage)\\b",
          "captures": {
            "2": {
              "name": "keyword"
            },
            "3": {
              "name": "keyword"
            }
          }
        },
        {
          "name": "keyword",
          "match": "\\b(add|adventure|align|as|at|blue|creative|dark_blue|dark_green|dark_red|ent|get|gold|gray|green|remove)\\b"
        },
        {
          "name": "keyword",
          "match": "\\b(if|keep|masked|modify|obj|players|pos|red|replace|run|score|set|spectator|survival|uninited|unless|facing)\\b"
        },
        {
          "name": "keyword",
          "match": "\\b(yellow|join|normal|force|give|clear|move|subtitle|title|max|reset|anchored|store|opr|aqua|dark_aqua|white)\\b"
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "variable.other.enummember",
              "match": "\\b(billboard|bold|can_grab|chest|chest_chance|clean|color|distance|feet|feet_chance|head|head_chance)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(health|invulnerable|italic|left_hand|left_hand_chance|legs|legs_chance|limit|loot_table|lore)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(motion|name|name_visible|no_ai|no_despawn|no_knockback|right_hand|right_hand_chance|rotation)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(shine|silent|tag|team|text|sort|hide|attack_damage|attack_speed|unbreakable|pickup_delay|item)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(data|in_ground|powered|lit|type|can_place_on|enchantments|stack|potion_color|potion|invisible|no_gravity)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(level|block|from_color|to_color|scale|north|south|west|east|tp_time|gm|dx|dy|dz|open|crit|about)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(sign|x_rotation|y_rotation|axis|size|selected_item|interaction|height|width|no_trade|profession|top|bottom)\\b"
            },
            {
              "name": "variable.other.enummember",
              "match": "\\b(left_rotation|translation)\\b"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "variable.other.enummember",
              "match": "\\b(alt|text|color|italic|bold)\\b"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric",
      "match": "(~?-?\\d+(\\.\\d+)?|~|(-?\\d+(\\.\\d+)?)?\\.\\.(-?\\d+(\\.\\d+)?)?|\\b(true|false)\\b)"
    },
    "strings": {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    "selectors": {
      "name": "entity.name.type",
      "match": "@[aepsr]"
    },
    "comments": {
      "name": "comment.line",
      "match": "//.*"
    },
    "identifiers": {
      "name": "variable.other",
      "match": "[a-zA-Z0-9_#:/]+"
    }
  },
  "scopeName": "source.neniy"
}